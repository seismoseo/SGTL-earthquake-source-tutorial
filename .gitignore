# Files git should not track in your copy of the tutorial: caches and editor or system leftovers.
# Your work in work/, including the check log work/.sgtl/progress.jsonl, IS tracked: commit it (docs/git_workflow.md).
__pycache__/
*.pyc
.ipynb_checkpoints/
*.egg-info/
.DS_Store
/site/
/.cache/
# SeisComP sessions contain local waveform copies and runtime logs. Keep only the
# reviewed picks CSV and provenance receipt in work/picks/ under version control.
/work/seiscomp/
