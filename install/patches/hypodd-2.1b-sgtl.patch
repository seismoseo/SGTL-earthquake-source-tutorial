--- a/include/hypoDD.inc
+++ b/include/hypoDD.inc
@@ -18,7 +18,7 @@
 
 c parameters for large size problems 
       parameter(MAXEVE=   6500,    
-     &          MAXDATA=  3000000,
+     &          MAXDATA= 15000000,
      &          MAXEVE0=  215,	
      &          MAXDATA0= 100000,	
      &          MAXLAY=   50,	
--- a/src/hypoDD/Makefile
+++ b/src/hypoDD/Makefile
@@ -23,7 +23,7 @@
 CFLAGS	= -O -I$(INCLDIR)
 
 #LDFLAGS = 
-LDFLAGS = -L/usr/lib/gcc/i686-apple-darwin10/4.2.1 -lgcc
+LDFLAGS =
 listflg = -L -c -O
 
 # Flags for GNU g77 compiler
